COMPOSE_PROJECT_NAME=mahaclear-ai

POSTGRES_DB=mahaclear
POSTGRES_USER=mahaclear
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_ENABLED=false
REDIS_CACHE_TTL_SECONDS=120

BACKEND_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
SECRET_KEY=replace-this-with-a-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEMO_PASSWORD=MahaClearDemo2026!
RISK_RULES_PATH=
WORKFLOW_RULES_PATH=
SLA_RULES_PATH=
SLA_CHECK_INTERVAL_SECONDS=300

# Optional assistant language layer
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

DATABASE_URL=postgresql+psycopg://mahaclear:change-this-local-password@postgres:5432/mahaclear
REDIS_URL=redis://redis:6379/0

# Optional external notifications
NOTIFICATION_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMS_WEBHOOK_URL=

# Optional authorized external integration endpoints
INTEGRATION_MODE=mock
INTEGRATION_TIMEOUT_SECONDS=12
