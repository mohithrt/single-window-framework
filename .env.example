COMPOSE_PROJECT_NAME=mahaclear-ai

POSTGRES_DB=mahaclear
POSTGRES_USER=mahaclear
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

REDIS_PORT=6379

BACKEND_PORT=8000
FRONTEND_PORT=5173
SECRET_KEY=replace-this-with-a-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEMO_PASSWORD=MahaClearDemo2026!
# Optional; defaults to backend/app/config/risk_rules.json.
# Bump the JSON version when changing rules so saved results show as outdated.
RISK_RULES_PATH=
WORKFLOW_RULES_PATH=
SLA_RULES_PATH=
SLA_CHECK_INTERVAL_SECONDS=300

# Optional application assistant language layer. Rule-based analysis works without these.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Used inside Docker Compose. The hostname is the Compose service name.
DATABASE_URL=postgresql+psycopg://mahaclear:change-this-local-password@postgres:5432/mahaclear
REDIS_URL=redis://redis:6379/0
