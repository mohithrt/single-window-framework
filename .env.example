COMPOSE_PROJECT_NAME=mahaclear-ai

POSTGRES_DB=mahaclear
POSTGRES_USER=mahaclear
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

REDIS_PORT=6379

BACKEND_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
SECRET_KEY=replace-this-with-a-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEMO_PASSWORD=MahaClearDemo2026!
# Optional; defaults to backend/app/config/risk_rules.json.
# Bump the JSON version when changing rules so saved results show as outdated.
RISK_RULES_PATH=
WORKFLOW_RULES_PATH=
SLA_RULES_PATH=
SLA_CHECK_INTERVAL_SECONDS=300

# Optional conversational LLM; deterministic rules remain the source of business calculations.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your_openrouter_api_key_here
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=700
LLM_MAX_HISTORY_MESSAGES=12
LLM_MAX_TOOL_ROUNDS=3

# Used inside Docker Compose. The hostname is the Compose service name.
DATABASE_URL=postgresql+psycopg://mahaclear:change-this-local-password@postgres:5432/mahaclear
REDIS_URL=redis://redis:6379/0
